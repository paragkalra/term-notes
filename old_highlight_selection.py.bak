#!/usr/bin/env python3
"""Save selected text as a note and keep it highlighted.

highlight_selection appends the current selection to a per-tab Markdown file
in NOTES_DIR (with a timestamp, tab title and working directory) and adds a Highlight Text trigger
to the current tab's session-local profile (the Default profile itself is not
modified), so the text is colored whenever it is redrawn. Highlights disappear
when the tab closes; the notes files are permanent.

Bind these in Settings -> Keys -> Key Bindings -> + -> Invoke Script Function:
    highlight_selection(session_id: id)
    clear_selection_highlights(session_id: id)
"""
import asyncio
import datetime
import glob
import logging
import os
import re

import iterm2

NOTES_DIR = os.path.expanduser("~/notes/iterm-highlights")

logging.basicConfig(
    filename=os.path.expanduser("~/Library/Logs/iterm2_highlight_selection.log"),
    level=logging.INFO,
    format="%(asctime)s %(message)s",
)

TAG = "Selection highlight"

# (text, background) pairs, cycled so each new highlight gets its own color.
COLORS = [
    ("#000000", "#FFFF00"),  # yellow
    ("#000000", "#7CFC00"),  # green
    ("#000000", "#00FFFF"),  # cyan
    ("#000000", "#FF9EFF"),  # pink
    ("#000000", "#FFA500"),  # orange
]


def pattern_for(line):
    # Match the words literally but tolerate any run of whitespace between
    # them, since TUIs often re-pad lines when they redraw.
    return r"\s+".join(re.escape(word) for word in line.split())


def is_ours(trigger):
    return trigger.get("name") == TAG


def clean_lines(text):
    # Drop the trailing padding and blank lines terminal selections pick up.
    return [line.rstrip() for line in (text or "").splitlines() if line.strip()]


def slug(title):
    # Keep letters/digits (any language), turn everything else -- including
    # the spinner glyphs Claude Code puts in titles -- into single dashes.
    return re.sub(r"[^\w.]+", "-", title or "").strip("-.")[:80] or "tab"


def notes_file_for(session_id, title):
    # One file per tab, named after the tab's current title. The session id
    # suffix identifies the tab's file across title changes and script
    # restarts; if the title has changed, the file is renamed to match.
    # (Split panes are separate sessions, so each pane gets its own file.)
    suffix = session_id.split("-")[0].lower()
    wanted = os.path.join(NOTES_DIR, f"{slug(title)}_{suffix}.md")
    existing = glob.glob(os.path.join(NOTES_DIR, f"*_{suffix}.md"))
    if existing and existing[0] != wanted:
        os.rename(existing[0], wanted)
    return wanted


def append_note(notes_file, lines, title, path):
    os.makedirs(NOTES_DIR, exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    context = " · ".join(part for part in (title, path) if part)
    quoted = "\n".join("> " + line.strip() for line in lines)
    with open(notes_file, "a", encoding="utf-8") as notes:
        notes.write(f"## {stamp}" + (f" — {context}" if context else "") + "\n\n")
        notes.write(quoted + "\n\n")


async def read_clipboard():
    proc = await asyncio.create_subprocess_exec(
        "/usr/bin/pbpaste", stdout=asyncio.subprocess.PIPE)
    out, _ = await proc.communicate()
    return out.decode("utf-8", errors="replace")


async def main(connection):
    app = await iterm2.async_get_app(connection)
    last_clipboard_note = {}

    @iterm2.RPC
    async def highlight_selection(session_id=iterm2.Reference("id")):
        session = app.get_session_by_id(session_id)
        if session is None:
            return
        selection = await session.async_get_selection()
        source = "selection"
        if selection.subSelections:
            text = await session.async_get_selection_text(selection)
        else:
            # Apps with their own mouse handling (e.g. Claude Code) make the
            # selection themselves and copy it to the clipboard, so iTerm
            # never sees it. Fall back to the clipboard, skipping text we
            # already saved from this tab so a stale clipboard isn't re-noted.
            source = "clipboard"
            text = await read_clipboard()
            if text == last_clipboard_note.get(session_id):
                logging.info("highlight_selection session=%s: clipboard already saved", session_id)
                return
            last_clipboard_note[session_id] = text
        lines = clean_lines(text)
        logging.info("highlight_selection session=%s source=%s lines=%r", session_id, source, lines)
        if not lines:
            return

        try:
            title = (await session.tab.async_get_variable("title") if session.tab else None) \
                or await session.async_get_variable("name")
            path = await session.async_get_variable("path")
            os.makedirs(NOTES_DIR, exist_ok=True)
            notes_file = notes_file_for(session_id, title)
            append_note(notes_file, lines, title, path)
            logging.info("saved note to %s", notes_file)
        except Exception:
            logging.exception("failed to save note")

        # Triggers match one line at a time, so a multi-line selection becomes
        # one trigger per line, all sharing the same color.
        profile = await session.async_get_profile()
        triggers = list(profile.triggers or [])
        existing = {t.get("regex") for t in triggers if is_ours(t)}
        highlight_count = len({t.get("parameter") for t in triggers if is_ours(t)})
        text_color, background = COLORS[highlight_count % len(COLORS)]

        for line in lines:
            pattern = pattern_for(line)
            if pattern in existing:
                continue
            trigger = iterm2.HighlightTrigger(
                pattern,
                iterm2.Color.from_hex(text_color),
                iterm2.Color.from_hex(background),
                instant=True,
                enabled=True,
            )
            encoded = trigger.encode
            encoded["name"] = TAG
            triggers.append(encoded)

        await profile.async_set_triggers(triggers)

    @iterm2.RPC
    async def clear_selection_highlights(session_id=iterm2.Reference("id")):
        session = app.get_session_by_id(session_id)
        if session is None:
            return
        profile = await session.async_get_profile()
        triggers = [t for t in (profile.triggers or []) if not is_ours(t)]
        await profile.async_set_triggers(triggers)

    await highlight_selection.async_register(connection)
    await clear_selection_highlights.async_register(connection)
    logging.info("registered")


iterm2.run_forever(main)
